{
  "name": "NeuralTower",
  "version": "1.0.0",
  "description": "Neural Tower productivity app",
  "main": "main.js",
  "author": "Kabir Co",
  "license": "MIT",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win appx"
  },

  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },

  "build": {
    "appId": "com.kabir.NeuralTower",
    "productName": "Neural Tower",

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*"
    ],

    "win": {
      "target": "appx"
    },

    "appx": {
      "applicationId": "NeuralTower",
      "displayName": "Neural Tower",
      "identityName": "Kabir.NeuralTower",
      "publisher": "CN=Kabir",
      "publisherDisplayName": "Kabir",
      "backgroundColor": "#000000"
    }
  }
}
