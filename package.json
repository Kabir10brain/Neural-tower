{
  "name": "neural-tower",
  "version": "1.0.0",
  "description": "Neural Tower productivity app",
  "main": "main.js",
  "author": "Kabir",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win appx"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kabir.neuraltower",
    "productName": "Neural Tower",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "appx"
      ],
      "icon": "icon.ico"
    },
    "appx": {
      "applicationId": "NeuralTower",
      "displayName": "Neural Tower",
      "publisher": "CN=Kabir",
      "publisherDisplayName": "Kabir",
      "identityName": "Kabir.NeuralTower",
      "backgroundColor": "#000000"
    }
  }
}
